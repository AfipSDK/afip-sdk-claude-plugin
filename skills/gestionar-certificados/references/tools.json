{
  "tools": [
    {
      "name": "issuers_edit",
      "product": "facturasdk",
      "scope": "issuers:write",
      "description": "issuers edit. Uses the project and environment of the connection; Factura SDK dev is a sandbox, not ARCA homologation.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "business_name": {
            "type": "string",
            "description": "Razón social",
            "maxLength": 200
          },
          "address": {
            "type": "string",
            "description": "Domicilio",
            "maxLength": 300
          },
          "vat_condition": {
            "type": "integer",
            "description": "Condición frente al IVA",
            "enum": [
              1,
              4,
              6,
              7,
              10,
              13,
              15,
              16
            ]
          },
          "gross_income": {
            "type": "string",
            "description": "Ingresos brutos",
            "maxLength": 50
          },
          "activity_start_date": {
            "type": "string",
            "description": "Inicio de actividades",
            "maxLength": 2000,
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "sales_point": {
            "oneOf": [
              {
                "type": "integer",
                "description": "Punto de venta",
                "minimum": 1,
                "maximum": 99999
              },
              {
                "const": null
              }
            ]
          },
          "certificate_id": {
            "oneOf": [
              {
                "type": "string",
                "description": "Certificado",
                "maxLength": 100
              },
              {
                "const": null
              }
            ]
          },
          "status": {
            "type": "string",
            "description": "Estado",
            "enum": [
              "active",
              "inactive"
            ],
            "maxLength": 2000
          },
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "^[A-Za-z0-9_-]+$"
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "title": "Editar emisor",
        "readOnlyHint": false,
        "destructiveHint": true,
        "idempotentHint": false,
        "openWorldHint": true
      }
    },
    {
      "name": "issuers_certificate",
      "product": "facturasdk",
      "scope": "issuers:write",
      "description": "Create and assign a certificate by ARCA automation using a stored credential. Manual PEM/private key uploads are dashboard-only.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "tax_id": {
            "type": "integer",
            "description": "CUIT"
          },
          "username": {
            "type": "string",
            "pattern": "^\\d{11}$",
            "description": "CUIT de inicio de sesión en ARCA con una credencial guardada en este proyecto. No es el CUIT representado, salvo que también sea el de acceso."
          },
          "alias": {
            "type": "string",
            "description": "Alias del certificado",
            "maxLength": 100
          },
          "previous_automation_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "description": "Only for an intentional new operation after consuming a completed result: the previous completed automation ID. Omit when retrying or resuming; never bypasses an operation still running or with an uncertain outcome."
          },
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "^[A-Za-z0-9_-]+$"
          }
        },
        "required": [
          "username",
          "id"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "title": "Crear y asignar certificado al emisor",
        "readOnlyHint": false,
        "destructiveHint": true,
        "idempotentHint": false,
        "openWorldHint": true
      }
    },
