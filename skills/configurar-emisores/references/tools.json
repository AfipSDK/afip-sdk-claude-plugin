{
  "tools": [
    {
      "name": "issuers_create",
      "product": "facturasdk",
      "scope": "issuers:write",
      "description": "issuers create. Uses the project and environment of the connection; Factura SDK dev is a sandbox, not ARCA homologation.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "tax_id": {
            "type": "integer",
            "description": "CUIT"
          },
          "business_name": {
            "type": "string",
            "description": "Razón social",
            "maxLength": 200
          },
          "address": {
            "type": "string",
            "description": "Domicilio",
            "maxLength": 300
          },
          "vat_condition": {
            "type": "integer",
            "description": "Condición frente al IVA",
            "enum": [
              1,
              4,
              6,
              7,
              10,
              13,
              15,
              16
            ]
          },
          "gross_income": {
            "type": "string",
            "description": "Ingresos brutos",
            "maxLength": 50
          },
          "activity_start_date": {
            "type": "string",
            "description": "Inicio de actividades",
            "maxLength": 2000,
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "sales_point": {
            "type": "integer",
            "description": "Punto de venta",
            "minimum": 1,
            "maximum": 99999
          },
          "certificate_id": {
            "type": "string",
            "description": "Certificado",
            "maxLength": 100
          }
        },
        "required": [
          "tax_id",
          "business_name",
          "address",
          "vat_condition",
          "gross_income",
          "activity_start_date"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "title": "Crear emisor",
        "readOnlyHint": false,
        "destructiveHint": true,
        "idempotentHint": false,
        "openWorldHint": true
      }
    },
