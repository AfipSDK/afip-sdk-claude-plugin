    {
      "name": "issuers_delegation",
      "product": "facturasdk",
      "scope": "issuers:write",
      "description": "Acepta en ARCA una delegación de facturación electrónica (WSFE) previamente otorgada por el emisor al titular del certificado activo asignado, de otro CUIT, y autoriza ese certificado para emitir por el emisor; no crea la delegación inicial. Usa una credencial de ARCA guardada en el proyecto y entorno de la conexión, con acceso al CUIT titular del certificado. Devuelve automation_id para consultar estado y resultado con automations_get. En producción realiza cambios reales en ARCA; en desarrollo se simula, sin usar homologación de ARCA.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "pattern": "^\\d{11}$",
            "description": "CUIT de inicio de sesión en ARCA con una credencial guardada en este proyecto. No es el CUIT representado, salvo que también sea el de acceso."
          },
          "previous_automation_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "description": "Only for an intentional new operation after consuming a completed result: the previous completed automation ID. Omit when retrying or resuming; never bypasses an operation still running or with an uncertain outcome."
          },
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "^[A-Za-z0-9_-]+$"
          }
        },
        "required": [
          "username",
          "id"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "title": "Aceptar delegación de facturación electrónica",
        "readOnlyHint": false,
        "destructiveHint": true,
        "idempotentHint": false,
        "openWorldHint": true
      }
    },
